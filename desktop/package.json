{
  "name": "simple-accounting",
  "version": "0.0.0",
  "engines": {
    "node": "24.x.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "electron": "ng build && electron .",
    "electron:dev": "ng serve & electron . --dev",
    "electron:pack": "ng build --configuration production && electron-builder",
    "electron:pack-win": "ng build --configuration production && electron-builder --win",
    "electron:pack-mac": "ng build --configuration production && electron-builder --mac",
    "electron:pack-linux": "ng build --configuration production && electron-builder --linux"
  },
  "main": "electron.js",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.2.0",
  "dependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@angular/animations": "21.0.0",
    "@angular/common": "21.0.0",
    "@angular/compiler": "21.0.0",
    "@angular/core": "21.0.0",
    "@angular/forms": "21.0.0",
    "@angular/platform-browser": "21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "21.0.0",
    "@primeuix/themes": "1.0.0",
    "primeicons": "7.0.0",
    "primeng": "21.0.0",
    "tslib": "2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "electron": "39.2.3",
    "electron-builder": "^26.7.0",
    "jsdom": "^28.0.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.0",
    "typescript": "~5.9",
    "vitest": "^4.0.18"
  }
}
